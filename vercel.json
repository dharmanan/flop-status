{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Static FLOP frontend'",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://flop-status-production.up.railway.app; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/agent",
      "destination": "/index.html"
    },
    {
      "source": "/verify/:receiptId",
      "destination": "/verify.html"
    },
    {
      "source": "/certificate/:certificateId",
      "destination": "/api/certificate-page?certificateId=:certificateId"
    },
    {
      "source": "/certificate-card/c:capability.png",
      "destination": "/api/certificate-card?capability=:capability"
    }
  ],
  "functions": {
    "api/certificate-page.js": {
      "includeFiles": "web/certificate.html"
    }
  }
}
