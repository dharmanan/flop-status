{
  "name": "flopstatus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/runtime/server.js",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "tclk:backfill-venue-timestamps": "npm run build && node dist/db/backfill-tclk-venue-timestamps.js",
    "db:verify": "npm run build && node dist/db/verify-railway.js",
    "db:verify-submission": "npm run build && node dist/db/verify-submission-railway.js",
    "db:verify-receipt": "npm run build && node dist/db/verify-receipt-railway.js",
    "acceptance:external-agent": "npm run build && node dist/acceptance/verify-external-agent-deployed.js",
    "acceptance:trial2": "npm run build && node dist/acceptance/verify-trial2-deployed.js",
    "acceptance:trial3": "npm run build && node dist/acceptance/verify-trial3-deployed.js",
    "acceptance:trial4": "npm run build && node dist/acceptance/verify-trial4-deployed.js",
    "acceptance:capability1-production": "npm run build && node dist/acceptance/verify-capability1-production-deployed.js",
    "attestation:generate": "npm run build && node dist/receipts/generate-attestation-key.js"
  },
  "dependencies": {
    "@flop-labs/tclk": "0.1.0",
    "canonicalize": "^4.0.0",
    "pg": "8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
